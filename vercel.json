{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://sawariya-cafe-8bmf.onrender.com/api/:match*"
    },
    {
      "source": "/socket.io",
      "destination": "https://sawariya-cafe-8bmf.onrender.com/socket.io"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://sawariya-cafe-8bmf.onrender.com/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
