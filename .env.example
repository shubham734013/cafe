# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Role-based Staff PINs & session signing secret (server-side only; NEVER use VITE_ prefix)
# Replace each placeholder with a unique 4-digit PIN before starting the app.
# In production, use private PINs and a cryptographically random secret of at least 32 characters.
CAFE_ADMIN_PIN="7777"
CAFE_KITCHEN_PIN="3456"
CAFE_AUTH_SECRET="replace-with-a-long-random-secret-of-at-least-32-chars"

# Allowed CORS Origins (comma-separated list for production)
CORS_ORIGIN="https://cafe.example.com"

# Reverse Proxy Trust (Set to "true" if deployed behind Cloudflare, AWS ALB, Nginx, etc.)
TRUST_PROXY="true"

# CAPTCHA Protection on Public Reservation & Email Forms
# When enabled, clients must provide a valid captchaToken verified server-side
ENABLE_CAPTCHA_VERIFICATION="false"
CAPTCHA_SECRET_KEY=""
CAPTCHA_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"

# Distributed Rate Limiting (Optional Redis store for clustered/multi-instance deployments)
REDIS_URL=""

# CafeOS MongoDB persistence. Local MongoDB defaults to 127.0.0.1:27017.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="cafeos"

# Optional UPI Gateway server-to-server integration.
UPI_GATEWAY_API_URL="https://payments.example.com"
UPI_GATEWAY_API_KEY=""
UPI_GATEWAY_API_SECRET=""
UPI_GATEWAY_WEBHOOK_SECRET=""

# Cashfree Payments (Official Payment Gateway — 0% on UPI)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_ENVIRONMENT="SANDBOX"

# Brevo Transactional Email Service
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="welcome@sethsawariya.com"
BREVO_SENDER_NAME="Seth Sawariya Cafe & Roastery"
