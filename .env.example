# Local development
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002,http://localhost:5173

# MongoDB is the authoritative operational store.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=cafeos
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# Server-side staff authentication. Set distinct 4-digit PINs for local use and
# unique non-default PINs plus a random secret before production deployment.
# These values must never use a VITE_ prefix.
CAFE_ADMIN_PIN=
CAFE_KITCHEN_PIN=
CAFE_AUTH_SECRET=

# Reverse proxy trust: 0 unless requests arrive through a known, fixed number of
# trusted proxy hops. The application origin must not be directly reachable if
# this is greater than 0.
TRUST_PROXY_HOPS=0

# Optional CAPTCHA. If enabled, a valid server-side secret is required.
ENABLE_CAPTCHA_VERIFICATION=false
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Optional payment providers. Without complete server credentials, payments
# are unavailable; configure sandbox credentials for validation, not live ones.
UPI_GATEWAY_API_URL=
UPI_GATEWAY_API_KEY=
UPI_GATEWAY_API_SECRET=
UPI_GATEWAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENVIRONMENT=SANDBOX

# Optional Brevo transactional email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Optional customer authentication. Supabase anon keys and Google client IDs
# are public browser configuration; never put service-role keys or client secrets
# in VITE_ variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional PostgreSQL analytics/archive tooling. MongoDB remains authoritative.
DATABASE_URL=
POSTGRES_URL=
PG_MAX_POOL=10
