# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Role-based Staff PINs & session signing secret (server-side only; NEVER use VITE_ prefix)
# Replace each placeholder with a private unique 4-digit PIN before starting the app.
# In production, use private unique PINs (defaults like 7777, 3456, 1234 are strictly rejected by the server).
# CAFE_AUTH_SECRET must be a cryptographically random secret of at least 32 characters (rejects weak defaults).
CAFE_ADMIN_PIN="[GENERATE_UNIQUE_4_DIGIT_ADMIN_PIN]"
CAFE_KITCHEN_PIN="[GENERATE_UNIQUE_4_DIGIT_KITCHEN_PIN]"
CAFE_AUTH_SECRET="[GENERATE_RANDOM_SECRET_MIN_32_BYTES_HEX]"

# Optional Admin Two-Factor Authentication (TOTP, RFC 6238)
ADMIN_TOTP_SECRET=""

# Allowed CORS Origins (comma-separated list for production)
CORS_ORIGIN="https://cafe.example.com"

# Reverse Proxy Trust (Set to "true" if deployed behind Cloudflare, AWS ALB, Nginx, etc.)
TRUST_PROXY="true"

# CAPTCHA Protection on Public Reservation & Email Forms
# When enabled, clients must provide a valid captchaToken verified server-side
ENABLE_CAPTCHA_VERIFICATION="false"
CAPTCHA_SECRET_KEY=""
CAPTCHA_VERIFY_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"

# Distributed Rate Limiting (Optional Redis store for clustered/multi-instance deployments)
REDIS_URL=""

# CafeOS MongoDB persistence. Local MongoDB defaults to 127.0.0.1:27017.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="cafeos"

# Optional UPI Gateway server-to-server integration.
UPI_GATEWAY_API_URL="https://payments.example.com"
UPI_GATEWAY_API_KEY=""
UPI_GATEWAY_API_SECRET=""
UPI_GATEWAY_WEBHOOK_SECRET=""

# Cashfree Payments (Official Payment Gateway — 0% on UPI)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_ENVIRONMENT="SANDBOX"

# Brevo Transactional Email Service
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="welcome@sethsawariya.com"
BREVO_SENDER_NAME="Seth Sawariya Cafe & Roastery"

# Method 2: Direct Zomato Food Ordering Partner API
ZOMATO_PARTNER_API_KEY=""
ZOMATO_WEBHOOK_SECRET=""
ZOMATO_RES_ID="18942123"
ZOMATO_API_BASE_URL="https://api.zomato.com/v1/partner"

# Method 2: Direct Swiggy Connect Partner API
SWIGGY_PARTNER_API_KEY=""
SWIGGY_WEBHOOK_SECRET=""
SWIGGY_RESTAURANT_ID="SWG-87612"
SWIGGY_API_BASE_URL="https://partner.swiggy.com/v1"
