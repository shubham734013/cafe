# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Role-based Staff PINs & session signing secret (server-side only; NEVER use VITE_ prefix)
# Replace each placeholder with a unique 4-digit PIN before starting the app.
# In production, use private PINs and a cryptographically random secret of at least 32 characters.
CAFE_OWNER_PIN="SET_ME"
CAFE_MANAGER_PIN="SET_ME"
CAFE_CASHIER_PIN="SET_ME"
CAFE_BARISTA_PIN="SET_ME"
CAFE_SERVER_PIN="SET_ME"
CAFE_SUPER_ADMIN_PIN="SET_ME"
CAFE_AUTH_SECRET="replace-with-a-long-random-secret"

# CafeOS MongoDB persistence. Local MongoDB defaults to 127.0.0.1:27017.
# The first startup imports .data/cafe-state.json when the MongoDB state is empty.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="cafeos"

# Optional UPI Gateway server-to-server integration.
# Deploy/configure https://github.com/mynkdev-21/upi-gateway separately first.
# Never expose these credentials with a VITE_ prefix.
UPI_GATEWAY_API_URL="https://payments.example.com"
UPI_GATEWAY_API_KEY=""
UPI_GATEWAY_API_SECRET=""
UPI_GATEWAY_WEBHOOK_SECRET=""
