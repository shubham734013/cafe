# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Role-based Staff PINs & session signing secret (server-side only; NEVER use VITE_ prefix)
# In production, CAFE_AUTH_SECRET MUST be set to a long random secret (min 32 chars).
CAFE_OWNER_PIN="7777"
CAFE_MANAGER_PIN="1234"
CAFE_CASHIER_PIN="2345"
CAFE_BARISTA_PIN="3456"
CAFE_SERVER_PIN="4567"
CAFE_AUTH_SECRET="replace-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# YouPI-PG Self-Hosted UPI Payment Gateway (https://github.com/youpi-pg/YouPI-PG)
# Leave YOUPI_API_URL / YOUPI_MERCHANT_ID / YOUPI_MERCHANT_API_KEY empty in
# local development to use the built-in signed webhook sandbox simulator.
# In production, all three + YOUPI_WEBHOOK_SECRET MUST be configured.
# ---------------------------------------------------------------------------
YOUPI_API_URL=""
YOUPI_CHECKOUT_URL="http://localhost:7000"
YOUPI_MERCHANT_ID=""
YOUPI_MERCHANT_API_KEY=""
YOUPI_WEBHOOK_SECRET=""
YOUPI_PAYEE_VPA="sethsawariya@okhdfcbank"

# Keep "false" (recommended): OBSERVED_SUCCESS waits for bank statement CSV
# reconciliation (RECONCILED) or staff "Verify Bank Credit" before marking paid.
# Set "true" only if you accept observer SMS/Gmail alerts as instant settlement.
YOUPI_CONFIRM_ON_OBSERVER="false"
