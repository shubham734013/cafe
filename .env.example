# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Role-based Staff PINs & session signing secret (server-side only; NEVER use VITE_ prefix)
# Development PINs only. Production must set every role PIN privately and uniquely.
# The current shared-role PIN model is a migration limitation; do not reuse credentials.
# CAFE_AUTH_SECRET must be a cryptographically random secret of at least 32 characters.
CAFE_OWNER_PIN="SET_ME"
CAFE_MANAGER_PIN="SET_ME"
CAFE_CASHIER_PIN="SET_ME"
CAFE_BARISTA_PIN="SET_ME"
CAFE_SERVER_PIN="SET_ME"
CAFE_SUPER_ADMIN_PIN="SET_ME"
CAFE_AUTH_SECRET="replace-with-a-long-random-secret"

# CafeOS MongoDB persistence. Local URI is for development only.
# Production requires a managed/non-local MongoDB deployment and a durable backup policy.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="cafeos"

# Optional UPI Gateway server-to-server integration.
# Deploy/configure https://github.com/mynkdev-21/upi-gateway separately first.
# Never expose these credentials with a VITE_ prefix.
UPI_GATEWAY_API_URL="https://payments.example.com"
UPI_GATEWAY_API_KEY=""
UPI_GATEWAY_API_SECRET=""
UPI_GATEWAY_WEBHOOK_SECRET=""

# Production-only deployment configuration
# Set exact HTTPS origins, comma-separated if multiple frontends are used.
CORS_ORIGIN="https://your-cafe-domain.example"
# Number of trusted reverse proxies between the client and Express. Keep 0 unless verified.
TRUST_PROXY_HOPS="0"

# Cashfree production credentials. Never use sandbox credentials in production.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_WEBHOOK_SECRET=""
CASHFREE_ENVIRONMENT="SANDBOX"
CASHFREE_API_VERSION="2023-08-01"
