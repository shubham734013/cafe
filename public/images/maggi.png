<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
    <defs>
      <radialGradient id="maggiBg" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#FFF9E6"/>
        <stop offset="100%" stop-color="#F7E1AE"/>
      </radialGradient>
      <linearGradient id="bowl" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#E63946"/>
        <stop offset="100%" stop-color="#BA181B"/>
      </linearGradient>
    </defs>
    <circle cx="100" cy="100" r="92" fill="url(#maggiBg)"/>
    <!-- Steam -->
    <path d="M 85 45 Q 80 32 88 22" stroke="#D3B89D" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.6"/>
    <path d="M 102 42 Q 108 30 102 20" stroke="#D3B89D" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.6"/>
    <path d="M 120 46 Q 115 34 122 24" stroke="#D3B89D" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.6"/>
    <!-- Shadow -->
    <ellipse cx="100" cy="168" rx="60" ry="10" fill="#E0C39E" opacity="0.7"/>
    <!-- Bowl -->
    <path d="M 40 100 C 42 155, 158 155, 160 100 Z" fill="url(#bowl)"/>
    <ellipse cx="100" cy="100" rx="60" ry="15" fill="#FFBA08"/>
    <!-- Noodles wavy swirls -->
    <path d="M 52 98 Q 62 82 72 98 Q 82 112 92 98 Q 102 82 112 98 Q 122 112 132 98 Q 142 82 150 98" stroke="#FFE3A8" stroke-width="5" stroke-linecap="round" fill="none"/>
    <path d="M 58 104 Q 70 90 82 104 Q 94 116 106 104 Q 118 90 130 104 Q 140 114 146 104" stroke="#FFD000" stroke-width="4.5" stroke-linecap="round" fill="none"/>
    <path d="M 68 94 Q 78 80 88 94 Q 100 106 110 94 Q 120 80 130 94" stroke="#FFE3A8" stroke-width="4" stroke-linecap="round" fill="none"/>
    <!-- Veggies: Peas & Carrots -->
    <circle cx="75" cy="94" r="4.5" fill="#38B000"/>
    <circle cx="105" cy="92" r="4.5" fill="#38B000"/>
    <circle cx="132" cy="102" r="4.5" fill="#38B000"/>
    <rect x="88" y="102" width="7" height="6" rx="1.5" fill="#FF5400"/>
    <rect x="118" y="96" width="7" height="6" rx="1.5" fill="#FF5400"/>
    <rect x="65" y="104" width="7" height="6" rx="1.5" fill="#FF5400"/>
    <!-- Fork picking noodles -->
    <path d="M 148 40 L 126 88" stroke="#ADB5BD" stroke-width="4" stroke-linecap="round"/>
    <path d="M 122 84 L 132 92" stroke="#ADB5BD" stroke-width="3" stroke-linecap="round"/>
  </svg>