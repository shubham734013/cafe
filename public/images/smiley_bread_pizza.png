<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
    <defs>
      <radialGradient id="smileBg" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#FFF8EE"/>
        <stop offset="100%" stop-color="#FAD4B2"/>
      </radialGradient>
    </defs>
    <circle cx="100" cy="100" r="92" fill="url(#smileBg)"/>
    <!-- Bread slice -->
    <rect x="42" y="45" width="116" height="114" rx="18" fill="#D4A373"/>
    <rect x="48" y="51" width="104" height="102" rx="14" fill="#FFD166"/>
    <!-- Melted Cheese Layer -->
    <rect x="52" y="55" width="96" height="94" rx="10" fill="#FFF2B2"/>
    <!-- Big Joyful Smiley Face made of Olive/Capsicum/Sauce -->
    <!-- Eyes -->
    <circle cx="78" cy="85" r="9" fill="#2B2D42"/>
    <circle cx="78" cy="83" r="3" fill="#FFF"/>
    <circle cx="122" cy="85" r="9" fill="#2B2D42"/>
    <circle cx="122" cy="83" r="3" fill="#FFF"/>
    <!-- Rosy Cheek Toppings (Tomato) -->
    <circle cx="65" cy="105" r="7" fill="#E63946" opacity="0.8"/>
    <circle cx="135" cy="105" r="7" fill="#E63946" opacity="0.8"/>
    <!-- Big Happy Smile (Ketchup / Sauce curve) -->
    <path d="M 74 110 Q 100 138 126 110" stroke="#D90429" stroke-width="7" stroke-linecap="round" fill="none"/>
    <!-- Corn & Herb sprinkles -->
    <circle cx="68" cy="68" r="4" fill="#FFB703"/>
    <circle cx="132" cy="68" r="4" fill="#FFB703"/>
    <circle cx="100" cy="62" r="4" fill="#FFB703"/>
    <circle cx="100" cy="138" r="4" fill="#FFB703"/>
  </svg>