<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
    <defs>
      <radialGradient id="friesBg" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#FFFDF5"/>
        <stop offset="100%" stop-color="#FCEFD2"/>
      </radialGradient>
      <linearGradient id="cupFries" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#E63946"/>
        <stop offset="100%" stop-color="#BA181B"/>
      </linearGradient>
    </defs>
    <circle cx="100" cy="100" r="92" fill="url(#friesBg)"/>
    <ellipse cx="100" cy="168" rx="48" ry="8" fill="#E2D4BC" opacity="0.7"/>
    <!-- Individual Golden Fries Sticking Out -->
    <rect x="70" y="42" width="10" height="70" rx="3" fill="#FFB703" transform="rotate(-15 75 77)"/>
    <rect x="85" y="32" width="10" height="80" rx="3" fill="#FFC300" transform="rotate(-5 90 72)"/>
    <rect x="100" y="28" width="11" height="85" rx="3" fill="#FFB703" transform="rotate(4 105 70)"/>
    <rect x="115" y="35" width="10" height="75" rx="3" fill="#FFC300" transform="rotate(12 120 72)"/>
    <rect x="128" y="48" width="10" height="65" rx="3" fill="#FFB703" transform="rotate(22 133 80)"/>
    <rect x="78" y="52" width="10" height="60" rx="3" fill="#E09F3E" transform="rotate(-8 83 82)"/>
    <rect x="108" y="46" width="10" height="65" rx="3" fill="#E09F3E" transform="rotate(8 113 78)"/>
    <!-- Red Cafe Cup -->
    <path d="M 64 95 L 74 162 C 75 165, 125 165, 126 162 L 136 95 Z" fill="url(#cupFries)"/>
    <ellipse cx="100" cy="95" rx="36" ry="8" fill="#D90429"/>
    <!-- TSC Logo on Cup -->
    <circle cx="100" cy="132" r="14" fill="#FFB703"/>
    <text x="100" y="136" font-size="9" font-weight="900" fill="#BA181B" text-anchor="middle" font-family="sans-serif">TSC</text>
  </svg>