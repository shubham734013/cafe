  // Simple state management for items checking and ticket lifecycle
  function toggleItem(element) {
    const checkIcon = element.querySelector('.item-check .material-symbols-outlined');
    const nameEl = element.querySelector('.item-name');
    const isChecked = checkIcon.classList.contains('opacity-100');

    if (isChecked) {
      checkIcon.classList.remove('opacity-100');
      checkIcon.classList.add('opacity-0');
      nameEl.classList.remove('line-through', 'text-on-surface-variant');
      nameEl.classList.add('text-on-surface');
      element.classList.remove('bg-surface-container-lowest', 'opacity-70');
      element.classList.add('bg-surface-container');
    } else {
      checkIcon.classList.remove('opacity-0');
      checkIcon.classList.add('opacity-100');
      nameEl.classList.add('line-through', 'text-on-surface-variant');
      nameEl.classList.remove('text-on-surface');
      element.classList.add('bg-surface-container-lowest', 'opacity-70');
      element.classList.remove('bg-surface-container');
    }
  }

