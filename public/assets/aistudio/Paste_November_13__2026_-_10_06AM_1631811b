  (function() {
    // Tab switching interactivity
    const tabs = document.querySelectorAll('.tab-chip');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('bg-primary-container', 'text-on-primary', 'font-semibold', 'shadow-sm');
          t.classList.add('bg-surface-container-high', 'text-on-surface-variant');
        });
        tab.classList.add('bg-primary-container', 'text-on-primary', 'font-semibold', 'shadow-sm');
        tab.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
      });
    });

    // Search filter interaction
    const searchInput = document.getElementById('inventorySearch');
    const rows = document.querySelectorAll('.ingredient-row');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        rows.forEach(row => {
          const text = row.innerText.toLowerCase();
          row.style.display = text.includes(query) ? 'flex' : 'none';
        });
      });
    }

    // Modal triggers
    const openBtn = document.getElementById('openAddModalBtn');
    const modal = document.getElementById('addIngredientModal');
    const closeBtn = document.getElementById('closeAddModalBtn');
    const cancelBtn = document.getElementById('cancelModalBtn');
    const saveBtn = document.getElementById('saveIngredientBtn');

    function toggleModal(show) {
      if (!modal) return;
      if (show) {
        modal.classList.remove('hidden');
      } else {
        modal.classList.add('hidden');
      }
    }

    if (openBtn) openBtn.addEventListener('click', () => toggleModal(true));
    if (closeBtn) closeBtn.addEventListener('click', () => toggleModal(false));
    if (cancelBtn) cancelBtn.addEventListener('click', () => toggleModal(false));
    if (saveBtn) {
      saveBtn.addEventListener('click', () => {
        toggleModal(false);
      });
    }

    // Restock button micro-tap feedback
    const restockButtons = document.querySelectorAll('.restock-btn');
    restockButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const origText = btn.innerHTML;
        btn.innerHTML = '<span class="material-symbols-outlined text-[14px]">done</span> Queued';
        setTimeout(() => {
          btn.innerHTML = origText;
        }, 1200);
      });
    });
  })();
